@model IEnumerable<LearningActivity.Models.Course>
@{
    ViewData["Title"] = "My Courses";
}

<div class="container my-5">
    <h1 class="text-primary mb-4">Current Courses</h1>
    <a asp-action="AddCourse" class="btn btn-primary mb-3">Add Course</a>
    <p class="lead text-muted">Here are the software development courses I am currently enrolled in:</p>

   
    <table id="coursesTable" class="table table-striped table-hover border mt-4">
        <thead class="table-dark">
            <tr>
                <th style="width: 15%;">Course Code</th>
                <th style="width: 35%;">Course Name</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var course in Model)

            {
                <tr>
                    <td class="font-weight-bold text-secondary">@course.CourseCode</td>
                    <td>@course.CourseName</td>
                    <td>@course.Description</td>
                    <td>
                        <a asp-action="EditCourse" asp-route-courseCode="@course.CourseCode"
                           class="btn btn-sm btn-outline-primary">
                            Edit
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/2.1.8/js/dataTables.min.js"></script>
    <script>
        $(function () {
            $('#coursesTable').DataTable();
        });
    </script>
}
